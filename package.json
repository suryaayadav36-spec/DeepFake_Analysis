{
  "name": "deepfake-analysis",
  "version": "1.0.0",
  "description": "Hackathon-ready deepfake analysis platform with TensorFlow.js CNN and LSTM training pipelines.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "PORT=3000 node server.js",
    "train:cnn": "node CNN/train.js CNN/dataset CNN/saved-model 20 16",
    "train:lstm": "node LSTM/train.js LSTM/dataset LSTM/saved-model 20 8 12 64",
    "check:data": "node scripts/check-dataset.js"
  },
  "keywords": [
    "deepfake",
    "analysis",
    "tensorflowjs",
    "computer-vision",
    "hackathon"
  ],
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.22.0"
  },
  "license": "MIT"
}
